<script>
// === DATA ===
const cars = [
  { id:1, brand:'Toyota', model:'Camry 2.5', year:2020, mileage:45000, price:2350000, fuel:'Бензин', transmission:'АКПП', drive:'Передний', power:'181 л.с.', color:'Белый', badge:'Хит', img:'https://images.unsplash.com/photo-1621007947382-bb3c3994e9fb?w=600' },
  { id:2, brand:'BMW', model:'320i xDrive', year:2019, mileage:78000, price:2150000, fuel:'Бензин', transmission:'АКПП', drive:'Полный', power:'184 л.с.', color:'Чёрный', badge:'Премиум', img:'https://images.unsplash.com/photo-1555215695-3004980ad54e?w=600' },
  { id:3, brand:'Mercedes', model:'E200 AMG', year:2021, mileage:32000, price:3850000, fuel:'Бензин', transmission:'АКПП', drive:'Задний', power:'197 л.с.', color:'Серебро', badge:'Премиум', img:'https://images.unsplash.com/photo-1617531653332-bd46c24f2068?w=600' },
  { id:4, brand:'Volkswagen', model:'Tiguan 2.0', year:2018, mileage:95000, price:1550000, fuel:'Бензин', transmission:'АКПП', drive:'Полный', power:'180 л.с.', color:'Серый', badge:'', img:'https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?w=600' },
  { id:5, brand:'Kia', model:'Rio 1.6', year:2020, mileage:62000, price:980000, fuel:'Бензин', transmission:'АКПП', drive:'Передний', power:'123 л.с.', color:'Красный', badge:'Выгодно', img:'https://images.unsplash.com/photo-1549399542-7e3f8b79c341?w=600' },
  { id:6, brand:'Hyundai', model:'Solaris 1.6', year:2019, mileage:85000, price:820000, fuel:'Бензин', transmission:'МКПП', drive:'Передний', power:'123 л.с.', color:'Белый', badge:'', img:'https://images.unsplash.com/photo-1580273916550-e323be2ae537?w=600' },
  { id:7, brand:'Toyota', model:'RAV4 2.0', year:2021, mileage:41000, price:2450000, fuel:'Бензин', transmission:'Вариатор', drive:'Полный', power:'149 л.с.', color:'Синий', badge:'Новинка', img:'https://images.unsplash.com/photo-1568844293986-8d0400bd4745?w=600' },
  { id:8, brand:'BMW', model:'X5 3.0d', year:2018, mileage:112000, price:3250000, fuel:'Дизель', transmission:'АКПП', drive:'Полный', power:'249 л.с.', color:'Чёрный', badge:'Премиум', img:'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=600' },
];

let favorites = JSON.parse(localStorage.getItem('cp67_fav') || '[]');

// === RENDER CARS ===
function renderCars(list) {
  const grid = document.getElementById('carsGrid');
  if (list.length === 0) {
    grid.innerHTML = '<p style="text-align:center;color:var(--muted);grid-column:1/-1;padding:40px;">Ничего не найдено 😕</p>';
    return;
  }
  grid.innerHTML = list.map(c => `
    <div class="car-card">
      <div class="car-img" style="background-image:url('${c.img}')">
        ${c.badge ? `<div class="car-badge">${c.badge}</div>` : ''}
        <button class="fav-btn ${favorites.includes(c.id)?'active':''}" data-fav="${c.id}">${favorites.includes(c.id)?'★':'☆'}</button>
      </div>
      <div class="car-body">
        <div class="car-title">${c.brand} ${c.model}</div>
        <div class="car-meta">${c.year} год</div>
        <div class="car-specs">
          <span>${c.mileage.toLocaleString('ru')} км</span>
          <span>${c.fuel}</span>
          <span>${c.transmission}</span>
        </div>
        <div class="car-price">${c.price.toLocaleString('ru')} ₽</div>
        <div class="car-actions">
          <button class="btn btn-sm" style="flex:1;" data-view="${c.id}">Подробнее</button>
          <button class="btn btn-sm btn-outline" data-call="${c.id}">📞</button>
        </div>
      </div>
    </div>
  `).join('');
}
renderCars(cars);

// === FILTERS ===
function applyFilters() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const brand = document.getElementById('brandFilter').value;
  const price = document.getElementById('priceFilter').value;
  let filtered = cars.filter(c => {
    const matchQ = !q || (c.brand+' '+c.model).toLowerCase().includes(q);
    const matchB = !brand || c.brand === brand;
    let matchP = true;
    if (price === '500000') matchP = c.price <= 500000;
    else if (price === '1000000') matchP = c.price <= 1000000;
    else if (price === '2000000') matchP = c.price <= 2000000;
    else if (price === '99999999') matchP = c.price > 2000000;
    return matchQ && matchB && matchP;
  });
  renderCars(filtered);
}
document.getElementById('searchInput').addEventListener('input', applyFilters);
document.getElementById('brandFilter').addEventListener('change', applyFilters);
document.getElementById('priceFilter').addEventListener('change', applyFilters);
document.getElementById('resetFilters').addEventListener('click', () => {
  document.getElementById('searchInput').value = '';
  document.getElementById('brandFilter').value = '';
  document.getElementById('priceFilter').value = '';
  applyFilters();
  showToast('Фильтры сброшены');
});

// === CARD EVENTS (delegation) ===
document.getElementById('carsGrid').addEventListener('click', e => {
  const favId = e.target.dataset.fav;
  const viewId = e.target.dataset.view;
  const callId = e.target.dataset.call;
  if (favId) toggleFav(+favId);
  if (viewId) openModal(+viewId);
  if (callId) showToast('📞 Менеджер свяжется с вами в течение 5 минут');
});

function toggleFav(id) {
  if (favorites.includes(id)) favorites = favorites.filter(x => x !== id);
  else { favorites.push(id); showToast('⭐ Добавлено в избранное'); }
  localStorage.setItem('cp67_fav', JSON.stringify(favorites));
  applyFilters();
}

// === MODAL ===
function openModal(id) {
  const c = cars.find(x => x.id === id);
  if (!c) return;
  document.getElementById('modalImg').style.backgroundImage = `url('${c.img}')`;
  document.getElementById('modalBody').innerHTML = `
    <h2>${c.brand} ${c.model}</h2>
    <div class="car-meta">${c.year} год • ${c.color}</div>
    <div class="car-price">${c.price.toLocaleString('ru')} ₽</div>
    <p class="modal-desc">Автомобиль в отличном состоянии, один владелец по ПТС, сервисная книжка, полный комплект резины. Юридически чист — готов к любой проверке.</p>
    <div class="modal-specs">
      <div class="modal-spec"><strong>Пробег</strong>${c.mileage.toLocaleString('ru')} км</div>
      <div class="modal-spec"><strong>Двигатель</strong>${c.fuel}, ${c.power}</div>
      <div class="modal-spec"><strong>Коробка</strong>${c.transmission}</div>
      <div class="modal-spec"><strong>Привод</strong>${c.drive}</div>
    </div>
    <button class="btn" style="width:100%;" onclick="showToast('📞 Заявка отправлена! Менеджер перезвонит.');closeModal();">Оставить заявку</button>
  `;
  document.getElementById('modal').classList.add('show');
}
function closeModal() { document.getElementById('modal').classList.remove('show'); }
document.getElementById('modalClose').addEventListener('click', closeModal);
document.getElementById('modal').addEventListener('click', e => { if (e.target.id === 'modal') closeModal(); });

// === CALCULATOR ===
document.getElementById('calcBtn').addEventListener('click', () => {
  const brand = parseFloat(document.getElementById('calcBrand').value);
  const year = +document.getElementById('calcYear').value;
  const mileage = +document.getElementById('calcMileage').value;
  const cond = parseFloat(document.getElementById('calcCondition').value);
  const base = +document.getElementById('calcBase').value;
  const currentYear = 2026;
  const ageFactor = Math.max(0.3, 1 - (currentYear - year) * 0.07);
  const mileageFactor = Math.max(0.4, 1 - mileage / 500000);
  let result = base * brand * ageFactor * mileageFactor * cond;
  result = Math.round(result / 1000) * 1000;
  document.getElementById('calcPrice').textContent = result.toLocaleString('ru') + ' ₽';
  document.getElementById('calcResult').classList.add('show');
  showToast('✅ Расчёт готов');
});

// === NAVIGATION ===
document.querySelectorAll('[data-target]').forEach(el => {
  el.addEventListener('click', e => {
    e.preventDefault();
    const id = el.dataset.target;
    const target = document.getElementById(id);
    if (target) {
      window.scrollTo({ top: target.offsetTop - 70, behavior:'smooth' });
      document.getElementById('navLinks').classList.remove('open');
    }
  });
});
document.getElementById('burger').addEventListener('click', () => {
  document.getElementById('navLinks').classList.toggle('open');
});

// === CONTACT FORM ===
document.getElementById('contactForm').addEventListener('submit', e => {
  e.preventDefault();
  const name = document.getElementById('cName').value.trim();
  const phone = document.getElementById('cPhone').value.trim();
  if (!name || !phone) { showToast('❌ Заполните имя и телефон'); return; }
  showToast(`✅ Спасибо, ${name}! Мы перезвоним в течение 10 минут.`);
  e.target.reset();
});

// === TOAST ===
let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 3000);
}
</script>
</body>
</html>