<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>carprice67 — Б/У автомобили в Смоленске</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI', Tahoma, sans-serif; }
  :root {
    --bg:#0f1724; --bg2:#1a2332; --card:#1e2a3d;
    --accent:#ff7a1a; --accent2:#ffa45c;
    --text:#e8ecf1; --muted:#9aa4b2; --border:#2a3649;
  }
  body { background:var(--bg); color:var(--text); line-height:1.6; }
  a { color:inherit; text-decoration:none; }
  .container { max-width:1200px; margin:0 auto; padding:0 20px; }

  /* HEADER */
  header {
    background:rgba(15,23,36,0.95); backdrop-filter:blur(10px);
    position:sticky; top:0; z-index:100; border-bottom:1px solid var(--border);
  }
  .nav { display:flex; justify-content:space-between; align-items:center; padding:18px 20px; max-width:1200px; margin:0 auto; }
  .logo { font-size:24px; font-weight:800; color:var(--accent); letter-spacing:-0.5px; }
  .logo span { color:var(--text); }
  .nav-links { display:flex; gap:28px; list-style:none; }
  .nav-links a { color:var(--text); font-weight:500; transition:color .2s; cursor:pointer; }
  .nav-links a:hover { color:var(--accent); }
  .burger { display:none; background:none; border:none; color:var(--text); font-size:28px; cursor:pointer; }

  /* HERO */
  .hero {
    background:linear-gradient(135deg, #0f1724 0%, #1a2332 50%, #2a1810 100%);
    padding:80px 20px; text-align:center; position:relative; overflow:hidden;
  }
  .hero::before {
    content:''; position:absolute; top:0; left:0; right:0; bottom:0;
    background:radial-gradient(circle at 70% 30%, rgba(255,122,26,0.15), transparent 50%);
  }
  .hero-content { position:relative; z-index:1; }
  .hero h1 { font-size:48px; margin-bottom:16px; line-height:1.2; }
  .hero h1 span { color:var(--accent); }
  .hero p { font-size:18px; color:var(--muted); margin-bottom:32px; max-width:600px; margin-left:auto; margin-right:auto; }
  .hero-stats { display:flex; justify-content:center; gap:40px; margin-top:40px; flex-wrap:wrap; }
  .stat { text-align:center; }
  .stat-num { font-size:32px; font-weight:800; color:var(--accent); }
  .stat-label { color:var(--muted); font-size:14px; }

  /* BUTTONS */
  .btn {
    display:inline-block; padding:14px 32px; background:var(--accent);
    color:#fff; border:none; border-radius:8px; font-size:16px; font-weight:600;
    cursor:pointer; transition:all .25s; text-align:center;
  }
  .btn:hover { background:var(--accent2); transform:translateY(-2px); box-shadow:0 10px 25px rgba(255,122,26,0.3); }
  .btn-outline { background:transparent; border:2px solid var(--accent); color:var(--accent); }
  .btn-outline:hover { background:var(--accent); color:#fff; }
  .btn-sm { padding:8px 18px; font-size:14px; }

  /* SECTIONS */
  section { padding:70px 20px; }
  .section-title { text-align:center; font-size:36px; margin-bottom:12px; }
  .section-subtitle { text-align:center; color:var(--muted); margin-bottom:40px; }

  /* CATALOG */
  #catalog { background:var(--bg2); }
  .filters {
    display:flex; gap:12px; flex-wrap:wrap; justify-content:center;
    margin-bottom:30px; background:var(--card); padding:20px; border-radius:12px;
  }
  .filters input, .filters select {
    padding:10px 14px; background:var(--bg); border:1px solid var(--border);
    color:var(--text); border-radius:8px; font-size:14px; min-width:160px;
  }
  .filters input:focus, .filters select:focus { outline:none; border-color:var(--accent); }

  .cars-grid {
    display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));
    gap:24px;
  }
  .car-card {
    background:var(--card); border-radius:14px; overflow:hidden;
    border:1px solid var(--border); transition:transform .25s, box-shadow .25s;
    display:flex; flex-direction:column;
  }
  .car-card:hover { transform:translateY(-5px); box-shadow:0 15px 35px rgba(0,0,0,0.4); }
  .car-img {
    height:180px; background-size:cover; background-position:center;
    position:relative;
  }
  .car-badge {
    position:absolute; top:12px; left:12px; background:var(--accent);
    color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:600;
  }
  .fav-btn {
    position:absolute; top:12px; right:12px; background:rgba(0,0,0,0.6);
    border:none; width:36px; height:36px; border-radius:50%; cursor:pointer;
    font-size:18px; color:#fff; transition:all .2s;
  }
  .fav-btn.active { background:var(--accent); }
  .car-body { padding:18px; flex-grow:1; display:flex; flex-direction:column; }
  .car-title { font-size:18px; font-weight:700; margin-bottom:6px; }
  .car-meta { color:var(--muted); font-size:13px; margin-bottom:12px; }
  .car-specs { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:14px; font-size:13px; color:var(--muted); }
  .car-specs span::before { content:'• '; color:var(--accent); }
  .car-price { font-size:22px; font-weight:800; color:var(--accent); margin-bottom:14px; }
  .car-actions { display:flex; gap:8px; margin-top:auto; }

  /* CALCULATOR */
  #calc { background:var(--bg); }
  .calc-wrap {
    max-width:700px; margin:0 auto; background:var(--card);
    padding:36px; border-radius:14px; border:1px solid var(--border);
  }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px; }
  .form-group { display:flex; flex-direction:column; }
  .form-group label { font-size:14px; color:var(--muted); margin-bottom:6px; }
  .form-group input, .form-group select {
    padding:12px; background:var(--bg); border:1px solid var(--border);
    color:var(--text); border-radius:8px; font-size:15px;
  }
  .form-group input:focus, .form-group select:focus { outline:none; border-color:var(--accent); }
  .calc-result {
    margin-top:24px; padding:24px; background:linear-gradient(135deg, var(--accent), #d95a00);
    border-radius:12px; text-align:center; display:none;
  }
  .calc-result.show { display:block; animation:fadeIn .4s; }
  .calc-result-label { font-size:14px; opacity:0.9; }
  .calc-result-price { font-size:36px; font-weight:800; margin-top:6px; }

  /* ABOUT */
  #about { background:var(--bg2); }
  .features {
    display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));
    gap:24px; margin-top:30px;
  }
  .feature {
    background:var(--card); padding:28px; border-radius:12px;
    border:1px solid var(--border); text-align:center;
  }
  .feature-icon { font-size:40px; margin-bottom:12px; }
  .feature h3 { margin-bottom:8px; }
  .feature p { color:var(--muted); font-size:14px; }

  /* CONTACT */
  #contact { background:var(--bg); }
  .contact-wrap {
    display:grid; grid-template-columns:1fr 1fr; gap:40px;
    max-width:900px; margin:0 auto;
  }
  .contact-info { background:var(--card); padding:32px; border-radius:14px; border:1px solid var(--border); }
  .contact-info h3 { margin-bottom:20px; color:var(--accent); }
  .contact-item { display:flex; gap:12px; margin-bottom:16px; align-items:flex-start; }
  .contact-item-icon { font-size:22px; }
  .contact-item-text strong { display:block; margin-bottom:2px; }
  .contact-item-text span { color:var(--muted); font-size:14px; }
  .contact-form { background:var(--card); padding:32px; border-radius:14px; border:1px solid var(--border); }
  .contact-form textarea {
    width:100%; padding:12px; background:var(--bg); border:1px solid var(--border);
    color:var(--text); border-radius:8px; font-size:15px; resize:vertical; min-height:100px;
    font-family:inherit; margin-bottom:16px;
  }
  .contact-form textarea:focus { outline:none; border-color:var(--accent); }

  /* FOOTER */
  footer {
    background:#0a1018; padding:30px 20px; text-align:center;
    color:var(--muted); border-top:1px solid var(--border);
  }
  footer .logo { margin-bottom:10px; }

  /* MODAL */
  .modal {
    display:none; position:fixed; top:0; left:0; width:100%; height:100%;
    background:rgba(0,0,0,0.8); z-index:1000; justify-content:center; align-items:center;
    padding:20px;
  }
  .modal.show { display:flex; animation:fadeIn .3s; }
  .modal-content {
    background:var(--card); border-radius:14px; max-width:600px; width:100%;
    max-height:90vh; overflow-y:auto; position:relative; border:1px solid var(--border);
  }
  .modal-close {
    position:absolute; top:14px; right:14px; background:rgba(0,0,0,0.5);
    border:none; color:#fff; width:36px; height:36px; border-radius:50%;
    font-size:20px; cursor:pointer; z-index:1;
  }
  .modal-img { height:260px; background-size:cover; background-position:center; border-radius:14px 14px 0 0; }
  .modal-body { padding:28px; }
  .modal-body h2 { margin-bottom:8px; }
  .modal-body .car-price { font-size:28px; margin:14px 0; }
  .modal-desc { color:var(--muted); margin-bottom:16px; }
  .modal-specs { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:20px; }
  .modal-spec { background:var(--bg); padding:10px; border-radius:8px; font-size:14px; }
  .modal-spec strong { color:var(--accent); display:block; font-size:12px; }

  /* TOAST */
  .toast {
    position:fixed; bottom:30px; right:30px; background:var(--accent);
    color:#fff; padding:14px 22px; border-radius:10px; box-shadow:0 10px 30px rgba(0,0,0,0.4);
    transform:translateX(400px); transition:transform .3s; z-index:2000; font-weight:500;
  }
  .toast.show { transform:translateX(0); }

  @keyframes fadeIn { from{opacity:0} to{opacity:1} }

  /* RESPONSIVE */
  @media (max-width:768px) {
    .nav-links { display:none; position:absolute; top:100%; left:0; right:0;
      background:var(--bg2); flex-direction:column; padding:20px; gap:16px; border-bottom:1px solid var(--border); }
    .nav-links.open { display:flex; }
    .burger { display:block; }
    .hero h1 { font-size:32px; }
    .form-row { grid-template-columns:1fr; }
    .contact-wrap { grid-template-columns:1fr; }
    .modal-specs { grid-template-columns:1fr; }
  }
</style>
</head>
